    "import numpy as np\n",
    "\n",
    "# Query the TIC catalog for these IDs\n",
    "# We specifically want the 'GAIA' column which contains the Gaia DR2/DR3 source_id\n",
    "tic_data = Catalogs.query_criteria(catalog=\"TIC\", ID=df_pc['TIC'].unique())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "af53e1b1-a297-41f9-8269-a398bcc47155",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "(11143, 46)"
      ]
     },
     "execution_count": 7,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "import pandas as pd\n",
    "\n",
    "df_gaia = tic_data.to_pandas()[['ID','GAIA','ra','dec','plx','pmRA','pmDEC']].astype(float)\n",
    "df_gaia['TIC'] = df_gaia.ID.copy()\n",
    "df_pc = pd.merge(df_pc, df_gaia, on='TIC')\n",
    "df_pc.shape"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "35f742ff-caeb-483d-a790-9fded480e287",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "INFO: Query finished. [astroquery.utils.tap.core]\n"
     ]
    }
   ],
   "source": [
    "from astroquery.gaia import Gaia\n",
    "\n",
    "# Extract unique Gaia IDs and remove masked/null values\n",
    "gaia_ids = [int(gid) for gid in tic_data['GAIA'] if gid is not np.ma.masked]\n",
    "\n",
    "# Format the IDs for the SQL 'IN' clause\n",
    "ids_str = \",\".join(map(str, gaia_ids))\n",
    "\n",
    "# ADQL query to get source_id and radial_velocity\n",
    "query = f\"\"\"\n",
    "SELECT source_id, radial_velocity, radial_velocity_error\n",
    "FROM gaiadr3.gaia_source\n",
    "WHERE source_id IN ({ids_str})\n",
    "\"\"\"\n",
    "\n",
    "# Launch the job\n",
    "job = Gaia.launch_job_async(query)\n",
    "results = job.get_results()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "2d4233bf-d2fd-49b4-af5e-a4a708ad3a6e",
   "metadata": {},
   "outputs": [],
   "source": [
    "df_rv = results.to_pandas().astype(float).rename({\n",
    "    'SOURCE_ID': 'GAIA',\n",
    "    }, axis=1\n",
    "                                  )\n",
    "df_pc = pd.merge(df_pc, df_rv, on='GAIA')"
   ]
  },
